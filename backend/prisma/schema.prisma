generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  spendingLimit Float    @default(5000)
  createdAt     DateTime @default(now())

  orders        Order[]
  agentActions  AgentAction[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  stock       Int      @default(0)
  category    String
  rating      Float    @default(0)
  createdAt   DateTime @default(now())

  orders      Order[]
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  productId       String
  amount          Float
  status          OrderStatus   @default(PENDING)
  razorpayOrderId String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  agentActions    AgentAction[]
}

model AgentAction {
  id          String       @id @default(cuid())
  userId      String
  orderId     String?
  action      String
  amount      Float?
  status      ActionStatus
  reason      String
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  APPROVED
  BLOCKED
  PAYMENT_CREATED
  PAID
  FAILED
  CANCELLED
}

enum ActionStatus {
  APPROVED
  BLOCKED
  FAILED
}