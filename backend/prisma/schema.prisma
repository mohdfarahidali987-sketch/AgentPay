generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  spendingLimit Float    @default(5000)
  createdAt     DateTime @default(now())

  orders        Order[]
  agentActions  AgentAction[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String @unique
  name        String
  description String

  price       Float
  stock       Int
  category    String
  rating      Float
  reviewCount Int      @default(0)
  brand       String?
  attributes  Json?
  createdAt   DateTime @default(now())

  orders      Order[]
}

model Order {
  id                String        @id @default(cuid())
  userId            String
  productId         String
  amount            Float
  status            OrderStatus   @default(PENDING)

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  createdAt         DateTime      @default(now())

  user              User          @relation(fields: [userId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])
  agentActions      AgentAction[]
}

model AgentAction {
  id          String       @id @default(cuid())
  userId      String
  orderId     String?
  action      String
  amount      Float?
  status      ActionStatus
  reason      String
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  APPROVED
  BLOCKED
  PAYMENT_CREATED
  PAID
  FAILED
  CANCELLED
}

enum ActionStatus {
  APPROVED
  BLOCKED
  FAILED
}